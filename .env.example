# Root env for local dev orchestration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:4010/ws
API_PORT=4000
SIGNALING_PORT=4010
REDIS_URL=redis://localhost:6379
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=turn.local.rtc
TURN_SHARED_SECRET=replace-with-strong-secret
INTERNAL_API_SECRET=replace-with-minimum-32-char-secret
TURN_EXTERNAL_IP=127.0.0.1
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49170
TURN_TLS_CERT_PATH=/etc/coturn/tls/tls.crt
TURN_TLS_KEY_PATH=/etc/coturn/tls/tls.key
LOG_LEVEL=info
MEDIASOUP_WORKER_COUNT=2
MEDIASOUP_WORKER_RTC_MIN_PORT=40000
MEDIASOUP_WORKER_RTC_MAX_PORT=49999
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_ENABLE_UDP=true
MEDIASOUP_ENABLE_TCP=true
MEDIASOUP_PREFER_UDP=true
MEDIASOUP_INITIAL_AVAILABLE_OUTGOING_BITRATE=1000000
MEDIASOUP_MAX_INCOMING_BITRATE=1500000
MEDIASOUP_LOG_TAGS=ice,dtls,rtp,rtcp,bwe,score,simulcast,svc
MEDIASOUP_CODECS_JSON=[{"kind":"audio","mimeType":"audio/opus","clockRate":48000,"channels":2},{"kind":"video","mimeType":"video/VP8","clockRate":90000,"parameters":{"x-google-start-bitrate":1000}}]
