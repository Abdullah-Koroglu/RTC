NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
JWT_SECRET=replace-with-minimum-32-char-secret
JWT_EXPIRES_IN=15m
DATABASE_ENABLED=true
DATABASE_URL=postgresql://rtc:rtc_password@localhost:5432/rtc
INTERNAL_API_SECRET=replace-with-minimum-32-char-secret-same-as-web
SHUTDOWN_GRACE_MS=10000
