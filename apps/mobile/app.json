{
  "expo": {
    "name": "Link",
    "slug": "link-rtc",
    "version": "1.0.0",
    "scheme": "link-rtc",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c14",
    "splash": {
      "backgroundColor": "#0a0c14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dis.link",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for video calls",
        "NSMicrophoneUsageDescription": "Microphone is used for audio calls"
      }
    },
    "android": {
      "package": "com.dis.link",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        { "faceIDPermission": "Allow Link to use Face ID" }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "signalingUrl": "http://localhost:4010",
      "signalingWsUrl": "ws://localhost:4010",
      "mediasoupUrl": "http://localhost:4020"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
